generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// 1. ENUMS
// ==========================================

enum PublicationStatus {
  draft
  published
}

enum PartnerInvitationStatus {
  pending
  accepted
  declined
  expired
  cancelled
}

// ==========================================
// 2. USER AUTHENTICATION & ROLES
// ==========================================

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(50)
  users User[]

  @@map("role")
}

model User {
  id              Int       @id @default(autoincrement())
  roleId          Int
  name            String    @db.VarChar(150)
  gender          String    @db.VarChar(30)
  phno            String?   @db.VarChar(30)
  email           String    @unique @db.VarChar(254)
  passwordHash    String    @map("password") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamp(0)
  profileImageUrl String?   @map("profile_image_url") @db.VarChar(2048)
  frontIdImg      String?   @db.VarChar(2048)
  backIdImg       String?   @db.VarChar(2048)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relationships
  role                       Role                           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  categories                 UserCategory[]
  createdTournaments         Tournament[]
  registrationsCreated       TournamentRegistration[]       @relation("RegistrationCreator")
  registrationMemberships    TournamentRegistrationMember[]
  partnerInvitationsSent     TournamentPartnerInvitation[]  @relation("PartnerInvitationSender")
  partnerInvitationsReceived TournamentPartnerInvitation[]  @relation("PartnerInvitationReceiver")

  @@index([roleId])
  @@map("users")
}

// ==========================================
// 3. PENDING REGISTRATIONS (ACCOUNT OTP)
// ==========================================

model PendingRegistration {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(150)
  gender          String   @db.VarChar(30)
  phno            String?  @db.VarChar(30)
  email           String   @unique @db.VarChar(254)
  passwordHash    String   @db.VarChar(255)
  profileImageUrl String?  @map("profile_image_url") @db.VarChar(2048)
  frontIdImg      String?  @db.VarChar(2048)
  backIdImg       String?  @db.VarChar(2048)
  categoryIds     Json?    @map("category_ids")
  otpHash         String   @db.VarChar(255)
  otpExpiresAt    DateTime @db.Timestamp(0)
  attempts        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([otpExpiresAt])
  @@map("pending_registrations")
}

// ==========================================
// 4. PLAYER CATEGORIES
// ==========================================

model Category {
  id    Int            @id @default(autoincrement())
  name  String         @unique @db.VarChar(100)
  users UserCategory[]

  @@map("categories")
}

model UserCategory {
  id           Int      @id @default(autoincrement())
  userId       Int
  categoryId   Int
  registeredAt DateTime @default(now()) @map("registered_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([categoryId])
  @@map("user_categories")
}

// ==========================================
// 5. TOURNAMENTS
// ==========================================

model Tournament {
  id                Int               @id @default(autoincrement())
  createdBy         Int               @map("created_by")
  title             String            @db.VarChar(200)
  bannerUrl         String?           @map("banner_url") @db.VarChar(2048)
  description       String?           @db.VarChar(500)
  startDate         DateTime          @map("start_date") @db.Date
  endDate           DateTime          @map("end_date") @db.Date
  rankingPointsPool Int               @default(0) @map("ranking_points_pool")
  publicationStatus PublicationStatus @default(draft) @map("publication_status")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  creator    User                 @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  venues     TournamentVenue[]
  rules      TournamentRule[]
  categories TournamentCategory[]

  @@index([createdBy])
  @@map("tournaments")
}

// ==========================================
// 6. TOURNAMENT VENUES
// ==========================================

model TournamentVenue {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  venueName    String   @map("venue_name") @db.VarChar(200)
  address      String   @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@map("tournament_venues")
}

// ==========================================
// 7. OFFICIAL TOURNAMENT RULES
// ==========================================

model TournamentRule {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  title        String   @db.VarChar(200)
  description  String   @db.Text
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@map("tournament_rules")
}

// ==========================================
// 8. TOURNAMENT EVENT CATEGORIES
// ==========================================

model TournamentCategory {
  id                  Int      @id @default(autoincrement())
  tournamentId        Int
  categoryCode        String   @map("category_code") @db.VarChar(30)
  categoryName        String   @map("category_name") @db.VarChar(150)
  entryFee            Decimal  @default(0) @map("entry_fee") @db.Decimal(12, 2)
  pairingType         String   @map("pairing_type") @db.VarChar(30)
  seedCount           Int      @default(0) @map("seed_count")
  matchFormat         String   @map("match_format") @db.VarChar(100)
  entryStatus         String   @default("open") @map("entry_status") @db.VarChar(30)
  eligibilityCriteria String?  @map("eligibility_criteria") @db.Text
  pointsPool          Int      @default(0) @map("points_pool")
  shuttleName         String?  @map("shuttle_name") @db.VarChar(150)
  shuttleSpeed        String?  @map("shuttle_speed") @db.VarChar(30)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tournament         Tournament                    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  pointTiers         CategoryPointTier[]
  registrations      TournamentRegistration[]
  partnerInvitations TournamentPartnerInvitation[]

  @@unique([tournamentId, categoryCode])
  @@index([tournamentId])
  @@map("tournament_categories")
}

// ==========================================
// 9. CATEGORY RANKING POINT ALLOCATION
// ==========================================

model CategoryPointTier {
  id                   Int      @id @default(autoincrement())
  tournamentCategoryId Int
  position             Int
  label                String   @db.VarChar(100)
  points               Int
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tournamentCategory TournamentCategory @relation(fields: [tournamentCategoryId], references: [id], onDelete: Cascade)

  @@unique([tournamentCategoryId, position])
  @@index([tournamentCategoryId])
  @@map("category_point_tiers")
}

// ==========================================
// 10. TOURNAMENT REGISTRATION STATUSES
// ==========================================

model TournamentRegistrationStatus {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  registrations TournamentRegistration[]

  @@map("tournament_registration_statuses")
}

// ==========================================
// 11. TOURNAMENT REGISTRATIONS
// ==========================================

model TournamentRegistration {
  id                   Int      @id @default(autoincrement())
  tournamentCategoryId Int
  registeredBy         Int
  statusId             Int
  registeredAt         DateTime @default(now()) @map("registered_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  category TournamentCategory           @relation(fields: [tournamentCategoryId], references: [id], onDelete: Restrict)
  creator  User                         @relation("RegistrationCreator", fields: [registeredBy], references: [id], onDelete: Restrict)
  status   TournamentRegistrationStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)

  members           TournamentRegistrationMember[]
  partnerInvitation TournamentPartnerInvitation?

  @@unique([id, tournamentCategoryId])
  @@index([tournamentCategoryId, statusId])
  @@index([registeredBy, statusId])
  @@map("tournament_registrations")
}

// ==========================================
// 12. REGISTRATION MEMBERS / PLAYERS
// ==========================================

model TournamentRegistrationMember {
  id                   Int      @id @default(autoincrement())
  registrationId       Int      @map("registration_id")
  tournamentCategoryId Int      @map("tournament_category_id")
  userId               Int      @map("user_id")
  createdAt            DateTime @default(now()) @map("created_at")

  registration TournamentRegistration @relation(fields: [registrationId, tournamentCategoryId], references: [id, tournamentCategoryId], onDelete: Cascade, map: "tournament_registration_members_registration_category_fkey")
  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([registrationId, userId])
  @@index([tournamentCategoryId, userId], map: "tournament_registration_members_category_user_idx")
  @@index([userId])
  @@map("tournament_registration_members")
}

// ==========================================
// 13. DOUBLES PARTNER INVITATIONS
// ==========================================

model TournamentPartnerInvitation {
  id                   Int                     @id @default(autoincrement())
  tournamentCategoryId Int
  invitedBy            Int                     @map("invited_by")
  invitedUserId        Int                     @map("invited_user_id")
  status               PartnerInvitationStatus @default(pending)
  expiresAt            DateTime                @map("expires_at")
  respondedAt          DateTime?               @map("responded_at")
  registrationId       Int?                    @unique @map("registration_id")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  category     TournamentCategory      @relation(fields: [tournamentCategoryId], references: [id], onDelete: Restrict)
  inviter      User                    @relation("PartnerInvitationSender", fields: [invitedBy], references: [id], onDelete: Restrict)
  invitedUser  User                    @relation("PartnerInvitationReceiver", fields: [invitedUserId], references: [id], onDelete: Restrict)
  registration TournamentRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([invitedUserId, status])
  @@index([invitedBy, status])
  @@index([tournamentCategoryId, status])
  @@map("tournament_partner_invitations")
}
