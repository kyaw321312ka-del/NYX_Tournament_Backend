generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(50)
  users User[]

  @@map("role")
}

model User {
  id              Int       @id @default(autoincrement())
  roleId          Int
  name            String    @db.VarChar(150)
  phno            String?   @db.VarChar(30)
  email           String    @unique @db.VarChar(254)
  passwordHash    String    @map("password") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamp(0)
  frontIdImg      String?   @db.VarChar(2048)
  backIdImg       String?   @db.VarChar(2048)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  role               Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  categories         UserCategory[]
  createdTournaments Tournament[]

  @@index([roleId])
  @@map("users")
}

model PendingRegistration {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(150)
  phno         String?  @db.VarChar(30)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @db.VarChar(255)
  otpHash      String   @db.VarChar(255)
  otpExpiresAt DateTime @db.Timestamp(0)
  attempts     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([otpExpiresAt])
  @@map("pending_registrations")
}

model Category {
  id    Int            @id @default(autoincrement())
  name  String         @unique @db.VarChar(100)
  users UserCategory[]

  @@map("categories")
}

model UserCategory {
  id           Int      @id @default(autoincrement())
  userId       Int
  categoryId   Int
  registeredAt DateTime @default(now()) @map("registered_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([categoryId])
  @@map("user_categories")
}

model Tournament {
  id                Int      @id @default(autoincrement())
  createdBy         Int      @map("created_by")
  title             String   @db.VarChar(200)
  entryFee          Decimal  @default(0) @map("entry_fee") @db.Decimal(12, 2)
  bannerUrl         String?  @map("banner_url") @db.VarChar(2048)
  description       String?  @db.VarChar(500)
  startDate         DateTime @map("start_date") @db.Date
  endDate           DateTime @map("end_date") @db.Date
  rankingPointsPool Int      @default(0) @map("ranking_points_pool")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  creator    User                 @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  venues     TournamentVenue[]
  rules      TournamentRule[]
  categories TournamentCategory[]

  @@index([createdBy])
  @@map("tournaments")
}

model TournamentVenue {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  venueName    String   @map("venue_name") @db.VarChar(200)
  address      String   @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@map("tournament_venues")
}

model TournamentRule {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  title        String   @db.VarChar(200)
  description  String   @db.Text
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@map("tournament_rules")
}

model TournamentCategory {
  id                  Int      @id @default(autoincrement())
  tournamentId        Int
  categoryCode        String   @map("category_code") @db.VarChar(30)
  categoryName        String   @map("category_name") @db.VarChar(150)
  pairingType         String   @map("pairing_type") @db.VarChar(30)
  seedCount           Int      @default(0) @map("seed_count")
  matchFormat         String   @map("match_format") @db.VarChar(100)
  entryStatus         String   @default("open") @map("entry_status") @db.VarChar(30)
  eligibilityCriteria String?  @map("eligibility_criteria") @db.Text
  pointsPool          Int      @default(0) @map("points_pool")
  shuttleName         String?  @map("shuttle_name") @db.VarChar(150)
  shuttleSpeed        String?  @map("shuttle_speed") @db.VarChar(30)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tournament Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  pointTiers CategoryPointTier[]

  @@unique([tournamentId, categoryCode])
  @@index([tournamentId])
  @@map("tournament_categories")
}

model CategoryPointTier {
  id                   Int      @id @default(autoincrement())
  tournamentCategoryId Int
  position             Int
  label                String   @db.VarChar(100)
  points               Int
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tournamentCategory TournamentCategory @relation(fields: [tournamentCategoryId], references: [id], onDelete: Cascade)

  @@unique([tournamentCategoryId, position])
  @@index([tournamentCategoryId])
  @@map("category_point_tiers")
}
